# Copie para .env e ajuste. Nunca commite segredos.
DATABASE_URL=postgresql://rebania:rebania@localhost:5432/rebania
# Banco exclusivo dos testes de integração (é recriado pelos testes)
TEST_DATABASE_URL=postgresql://rebania:rebania@localhost:5432/rebania_test
API_PORT=3000
API_HOST=127.0.0.1
# Origens web autorizadas (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173
# Base pública do web usada em links de convite
WEB_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
MEDIA_DIR=../../var/media

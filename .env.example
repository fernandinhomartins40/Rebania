# Copie para .env e ajuste. Nunca commite segredos.
DATABASE_URL=postgresql://rebania:rebania@localhost:5432/rebania
# Banco exclusivo dos testes de integração (é recriado pelos testes)
TEST_DATABASE_URL=postgresql://rebania:rebania@localhost:5432/rebania_test
API_PORT=3000
API_HOST=127.0.0.1
# Origens web autorizadas (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173
# Base pública do web usada em links de convite
WEB_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
MEDIA_DIR=../../var/media
# IA: "deepseek" + DEEPSEEK_API_KEY liga o assistente; "none" = indisponível.
AI_PROVIDER=none
# DEEPSEEK_API_KEY=
BILLING_PROVIDER=none
# METRICS_TOKEN=
# Cofre do console (chave do VeloMail e verificação em duas etapas da equipe).
# Gere com: openssl rand -base64 32. Sem ela o console funciona e avisa o que fica indisponível.
# PLATFORM_SECRETS_KEY=
# Versão exibida em Operação no console (o deploy preenche com o commit).
# APP_VERSION=dev

// Rebania — schema do banco. Convenções:
// - tabelas/colunas em snake_case (@@map/@map), modelos/campos em camelCase;
// - toda tabela de negócio carrega organization_id (tenant);
// - consistência de tenant reforçada por FKs compostas definidas em SQL
//   declaradas nas relações abaixo (ver docs/adr/ADR-002-tenancy.md);
// - índices parciais, CHECKs e triggers ficam em SQL nas migrations;
// - histórico é append-only: correções criam novos registros.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  field
  veterinarian
  finance
}

enum SessionChannel {
  web
  mobile
}

enum AnimalSex {
  female
  male
}

enum AnimalCategory {
  calf_female
  calf_male
  heifer
  steer
  cow
  bull
  ox
}

enum AnimalStatus {
  active
  sold
  dead
  culled
  transferred_out
}

enum AnimalOrigin {
  born_on_farm
  purchased
  transferred_in
  unknown
}

enum IdentifierType {
  visual_tag
  rfid
  nfc
  qr
  provisional
  other
}

enum IdentifierStatus {
  active
  retired
}

enum WeightSource {
  manual
  scale
  import
}

enum BreedingKind {
  artificial_insemination
  natural_service
  cleanup_bull
}

enum PregnancyResult {
  pregnant
  open
  inconclusive
}

enum ReproStatus {
  open
  bred
  pregnant
  unknown
}

enum TaskStatus {
  open
  done
  cancelled
}

enum AttachmentStatus {
  uploading
  processing
  ready
  failed
}

enum JobStatus {
  queued
  running
  done
  failed
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farms       Farm[]
  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

model Farm {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  timezone       String    @default("America/Sao_Paulo")
  /// Parâmetros configurados pela fazenda (ex.: reprodução), validados em @rebania/domain.
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id])
  animals      Animal[]
  groups       Group[]
  pastures     Pasture[]
  memberFarms  MembershipFarm[]
  identifiers  AnimalIdentifier[]
  weights      WeightMeasurement[]
  events       AnimalEvent[]
  mutations    SyncMutation[]
  changes      ChangeLog[]
  attachments  Attachment[]
  imports      ImportBatch[]
  seasons      BreedingSeason[]
  protocols    ReproProtocol[]
  executions   ProtocolExecution[]
  breedings    BreedingEvent[]
  checks       PregnancyCheck[]
  births       Birth[]
  tasks        Task[]
  products     Product[]
  batches      ProductBatch[]
  locations    StockLocation[]
  movements    StockMovement[]
  planItems    HealthPlanItem[]
  applications HealthApplication[]
  treatments   Treatment[]
  exams        Exam[]
  sessions     HandlingSession[]
  commercial   CommercialTransaction[]
  entries      FinancialEntry[]
  feedings     FeedingEvent[]

  @@unique([organizationId, id])
  @@map("farms")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    AuthSession[]

  @@map("users")
}

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           Role
  allFarms       Boolean   @default(false) @map("all_farms")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  farms        MembershipFarm[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@map("memberships")
}

model MembershipFarm {
  membershipId   String @map("membership_id") @db.Uuid
  farmId         String @map("farm_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  farm       Farm       @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@id([membershipId, farmId])
  @@map("membership_farms")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           Role
  allFarms       Boolean   @default(false) @map("all_farms")
  farmIds        String[]  @map("farm_ids") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model AuthSession {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  channel          SessionChannel
  accessHash       String         @unique @map("access_hash")
  accessExpiresAt  DateTime       @map("access_expires_at") @db.Timestamptz(3)
  refreshHash      String?        @unique @map("refresh_hash")
  refreshExpiresAt DateTime?      @map("refresh_expires_at") @db.Timestamptz(3)
  deviceLabel      String?        @map("device_label")
  userAgent        String?        @map("user_agent")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?        @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_sessions")
}

model AuditEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  farmId         String?  @map("farm_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  data           Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_entries")
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  name           String
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  farm     Farm           @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animals  Animal[]
  feedings FeedingEvent[]

  @@unique([farmId, id])
  @@map("groups")
}

model Pasture {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  name           String
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  farm    Farm     @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animals Animal[]

  @@unique([farmId, id])
  @@map("pastures")
}

model Animal {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  farmId              String         @map("farm_id") @db.Uuid
  sex                 AnimalSex
  category            AnimalCategory
  status              AnimalStatus   @default(active)
  breed               String?
  birthDate           DateTime?      @map("birth_date") @db.Date
  birthDateEstimated  Boolean        @default(false) @map("birth_date_estimated")
  origin              AnimalOrigin
  entryDate           DateTime?      @map("entry_date") @db.Date
  groupId             String?        @map("group_id") @db.Uuid
  pastureId           String?        @map("pasture_id") @db.Uuid
  damId               String?        @map("dam_id") @db.Uuid
  sireId              String?        @map("sire_id") @db.Uuid
  notes               String?
  /// Projeção da situação reprodutiva (recalculada a cada evento reprodutivo).
  reproStatus         ReproStatus?   @map("repro_status")
  reproStatusSince    DateTime?      @map("repro_status_since") @db.Date
  expectedCalvingOn   DateTime?      @map("expected_calving_on") @db.Date
  /// Projeção de carência (maior data entre aplicações não anuladas).
  withdrawalMeatUntil DateTime?      @map("withdrawal_meat_until") @db.Date
  withdrawalMilkUntil DateTime?      @map("withdrawal_milk_until") @db.Date
  /// Saída (venda, morte, descarte, transferência): data e motivo; histórico preservado.
  exitDate            DateTime?      @map("exit_date") @db.Date
  exitReason          String?        @map("exit_reason")
  version             Int            @default(1)
  createdById         String?        @map("created_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  farm              Farm                  @relation(fields: [organizationId, farmId], references: [organizationId, id])
  group             Group?                @relation(fields: [farmId, groupId], references: [farmId, id], onUpdate: Cascade)
  pasture           Pasture?              @relation(fields: [farmId, pastureId], references: [farmId, id], onUpdate: Cascade)
  dam               Animal?               @relation("Dam", fields: [organizationId, damId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  sire              Animal?               @relation("Sire", fields: [organizationId, sireId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  offspringAsDam    Animal[]              @relation("Dam")
  offspringAsSire   Animal[]              @relation("Sire")
  identifiers       AnimalIdentifier[]
  weights           WeightMeasurement[]
  events            AnimalEvent[]
  attachments       Attachment[]
  breedingsAsFemale BreedingEvent[]       @relation("BreedingFemale")
  breedingsAsSire   BreedingEvent[]       @relation("BreedingSire")
  checks            PregnancyCheck[]
  birthsAsDam       Birth[]               @relation("BirthDam")
  calfOf            BirthCalf[]
  semenProducts     Product[]             @relation("ProductSire")
  applications      HealthApplication[]
  treatments        Treatment[]
  exams             Exam[]
  sessionItems      HandlingSessionItem[]
  commercialItems   CommercialItem[]

  @@unique([organizationId, id])
  @@unique([farmId, id])
  @@index([farmId, status])
  @@index([farmId, groupId])
  @@index([farmId, expectedCalvingOn])
  @@map("animals")
}

model AnimalIdentifier {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  farmId          String           @map("farm_id") @db.Uuid
  animalId        String           @map("animal_id") @db.Uuid
  type            IdentifierType
  rawValue        String           @map("raw_value")
  normalizedValue String           @map("normalized_value")
  status          IdentifierStatus @default(active)
  source          String           @default("manual")
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt       DateTime?        @map("retired_at") @db.Timestamptz(3)
  retiredReason   String?          @map("retired_reason")

  animal Animal @relation(fields: [farmId, animalId], references: [farmId, id], onUpdate: Cascade)
  farm   Farm   @relation(fields: [organizationId, farmId], references: [organizationId, id], onUpdate: Cascade)

  @@index([farmId, normalizedValue])
  @@index([organizationId, normalizedValue])
  @@index([animalId])
  @@map("animal_identifiers")
}

model WeightMeasurement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  animalId       String       @map("animal_id") @db.Uuid
  weightKg       Decimal      @map("weight_kg") @db.Decimal(7, 2)
  measuredOn     DateTime     @map("measured_on") @db.Date
  source         WeightSource @default(manual)
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?    @map("voided_at") @db.Timestamptz(3)

  animal Animal @relation(fields: [organizationId, animalId], references: [organizationId, id])
  farm   Farm   @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@index([animalId, measuredOn])
  @@index([farmId, measuredOn])
  @@map("weight_measurements")
}

/// Linha do tempo do animal (projeção append-only). Correções criam nova entrada
/// apontando para a corrigida em `correctsEventId`.
model AnimalEvent {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  farmId           String   @map("farm_id") @db.Uuid
  animalId         String   @map("animal_id") @db.Uuid
  type             String
  occurredOn       DateTime @map("occurred_on") @db.Date
  data             Json     @default("{}")
  correctsEventId  String?  @map("corrects_event_id") @db.Uuid
  sourceMutationId String?  @map("source_mutation_id") @db.Uuid
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  animal Animal @relation(fields: [organizationId, animalId], references: [organizationId, id])
  farm   Farm   @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@index([animalId, occurredOn])
  @@map("animal_events")
}

/// Recibo idempotente de mutações (sync offline e requisições com Idempotency-Key).
model SyncMutation {
  mutationId     String   @id @map("mutation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  deviceId       String?  @map("device_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  type           String
  entityId       String?  @map("entity_id") @db.Uuid
  requestHash    String   @map("request_hash")
  receipt        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farm Farm @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@index([organizationId, createdAt])
  @@map("sync_mutations")
}

/// Feed de mudanças para o pull incremental (cursor = seq).
model ChangeLog {
  seq            BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  entity         String
  entityId       String   @map("entity_id") @db.Uuid
  op             String   @default("upsert")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farm Farm @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@index([farmId, seq])
  @@map("change_log")
}

/// Fila persistente em PostgreSQL (sem Redis). Consumida com SKIP LOCKED.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  payload     Json      @default("{}")
  status      JobStatus @default(queued)
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([status, queue, runAt])
  @@map("jobs")
}

/// Foto/documento do animal ou evento. Arquivos ficam no volume de mídia
/// (MEDIA_DIR), servidos apenas por rota autenticada. Upload retomável por offset.
model Attachment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  farmId         String           @map("farm_id") @db.Uuid
  animalId       String?          @map("animal_id") @db.Uuid
  eventId        String?          @map("event_id") @db.Uuid
  kind           String           @default("photo")
  mime           String
  sizeBytes      Int              @map("size_bytes")
  sha256         String
  uploadedBytes  Int              @default(0) @map("uploaded_bytes")
  status         AttachmentStatus @default(uploading)
  width          Int?
  height         Int?
  caption        String?
  takenOn        DateTime?        @map("taken_on") @db.Date
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt        DateTime?        @map("ready_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  failureReason  String?          @map("failure_reason")

  farm   Farm    @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animal Animal? @relation(fields: [organizationId, animalId], references: [organizationId, id])

  @@index([animalId, createdAt])
  @@map("attachments")
}

/// Registro de cada importação confirmada (auditoria; as linhas viram animais normais).
model ImportBatch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  fileName       String   @map("file_name")
  totalRows      Int      @map("total_rows")
  acceptedRows   Int      @map("accepted_rows")
  rejectedRows   Int      @map("rejected_rows")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farm Farm @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@map("import_batches")
}

model BreedingSeason {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  farm      Farm             @relation(fields: [organizationId, farmId], references: [organizationId, id])
  breedings BreedingEvent[]
  checks    PregnancyCheck[]

  @@unique([farmId, id])
  @@map("breeding_seasons")
}

/// Protocolo reprodutivo definido pela fazenda/veterinário. Cada edição cria nova versão.
model ReproProtocol {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  /// Agrupa as versões de um mesmo protocolo.
  lineageId      String    @map("lineage_id") @db.Uuid
  version        Int
  name           String
  /// [{ day, title, description, inseminate }]
  steps          Json
  responsible    String?
  notes          String?
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(3)

  farm       Farm                @relation(fields: [organizationId, farmId], references: [organizationId, id])
  executions ProtocolExecution[]

  @@unique([lineageId, version])
  @@unique([farmId, id])
  @@map("repro_protocols")
}

model ProtocolExecution {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  protocolId     String   @map("protocol_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  /// Snapshot dos animais no início (não muda se o filtro mudar depois).
  animalIds      String[] @map("animal_ids") @db.Uuid
  seasonId       String?  @map("season_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farm      Farm            @relation(fields: [organizationId, farmId], references: [organizationId, id])
  protocol  ReproProtocol   @relation(fields: [farmId, protocolId], references: [farmId, id])
  breedings BreedingEvent[]

  @@map("protocol_executions")
}

model BreedingEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  femaleId       String       @map("female_id") @db.Uuid
  kind           BreedingKind
  date           DateTime     @db.Date
  /// Fim da exposição (monta natural em período).
  endDate        DateTime?    @map("end_date") @db.Date
  sireId         String?      @map("sire_id") @db.Uuid
  semen          String?
  technician     String?
  seasonId       String?      @map("season_id") @db.Uuid
  executionId    String?      @map("execution_id") @db.Uuid
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidReason     String?      @map("void_reason")

  farm      Farm               @relation(fields: [organizationId, farmId], references: [organizationId, id])
  female    Animal             @relation("BreedingFemale", fields: [organizationId, femaleId], references: [organizationId, id])
  sire      Animal?            @relation("BreedingSire", fields: [organizationId, sireId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  season    BreedingSeason?    @relation(fields: [farmId, seasonId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  execution ProtocolExecution? @relation(fields: [executionId], references: [id])

  @@index([femaleId, date])
  @@index([farmId, date])
  @@map("breeding_events")
}

model PregnancyCheck {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  farmId                 String          @map("farm_id") @db.Uuid
  femaleId               String          @map("female_id") @db.Uuid
  date                   DateTime        @db.Date
  result                 PregnancyResult
  method                 String?
  examiner               String?
  estimatedGestationDays Int?            @map("estimated_gestation_days")
  seasonId               String?         @map("season_id") @db.Uuid
  notes                  String?
  createdById            String?         @map("created_by_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt               DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidReason             String?         @map("void_reason")

  farm   Farm            @relation(fields: [organizationId, farmId], references: [organizationId, id])
  female Animal          @relation(fields: [organizationId, femaleId], references: [organizationId, id])
  season BreedingSeason? @relation(fields: [farmId, seasonId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([femaleId, date])
  @@map("pregnancy_checks")
}

model Birth {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  damId          String   @map("dam_id") @db.Uuid
  date           DateTime @db.Date
  assistance     String   @default("none")
  sireId         String?  @map("sire_id") @db.Uuid
  notes          String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  farm   Farm        @relation(fields: [organizationId, farmId], references: [organizationId, id])
  dam    Animal      @relation("BirthDam", fields: [organizationId, damId], references: [organizationId, id])
  calves BirthCalf[]

  @@index([damId, date])
  @@index([farmId, date])
  @@map("births")
}

model BirthCalf {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  birthId        String    @map("birth_id") @db.Uuid
  /// Nulo para natimorto (registrado no parto, sem cadastro de animal).
  animalId       String?   @map("animal_id") @db.Uuid
  sex            AnimalSex
  stillborn      Boolean   @default(false)
  birthWeightKg  Decimal?  @map("birth_weight_kg") @db.Decimal(6, 2)

  birth  Birth   @relation(fields: [birthId], references: [id], onDelete: Cascade)
  animal Animal? @relation(fields: [organizationId, animalId], references: [organizationId, id])

  @@map("birth_calves")
}

/// Agenda: tarefas com origem rastreável (manejo, protocolo, configuração) ou manuais.
model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  farmId         String     @map("farm_id") @db.Uuid
  type           String
  title          String
  description    String?
  dueOn          DateTime   @map("due_on") @db.Date
  status         TaskStatus @default(open)
  /// Snapshot dos animais alvo.
  animalIds      String[]   @map("animal_ids") @db.Uuid
  assigneeId     String?    @map("assignee_id") @db.Uuid
  sourceType     String?    @map("source_type")
  sourceId       String?    @map("source_id") @db.Uuid
  dedupeKey      String?    @map("dedupe_key")
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  completedById  String?    @map("completed_by_id") @db.Uuid
  resolution     String?

  farm Farm @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@unique([farmId, dedupeKey])
  @@index([farmId, status, dueOn])
  @@map("tasks")
}

// ---- G4: sanidade, estoque e Modo Curral ---------------------------------------------

enum ProductKind {
  vaccine
  antiparasitic
  medicine
  hormone
  semen
  feed
  supplement
  other
}

enum StockMovementKind {
  entry
  consumption
  loss
  adjustment
}

enum HealthKind {
  vaccination
  deworming
  treatment
  other
}

enum AdminRoute {
  subcutaneous
  intramuscular
  intravenous
  oral
  pour_on
  intramammary
  intrauterine
  other
}

enum TreatmentStatus {
  open
  resolved
  failed
}

enum ExamStatus {
  pending
  done
}

enum HandlingSessionStatus {
  open
  closed
}

enum HandlingItemStatus {
  pending
  done
  skipped
}

/// Insumo da fazenda. Carência e fonte técnica são configuradas pela fazenda.
model Product {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  farmId             String      @map("farm_id") @db.Uuid
  name               String
  kind               ProductKind
  unit               String
  minStock           Decimal?    @map("min_stock") @db.Decimal(14, 3)
  withdrawalMeatDays Int?        @map("withdrawal_meat_days")
  withdrawalMilkDays Int?        @map("withdrawal_milk_days")
  withdrawalSource   String?     @map("withdrawal_source")
  /// Sêmen: touro cadastrado (opcional) ou nome livre.
  sireId             String?     @map("sire_id") @db.Uuid
  sireName           String?     @map("sire_name")
  notes              String?
  version            Int         @default(1)
  createdById        String?     @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(3)

  farm          Farm                @relation(fields: [organizationId, farmId], references: [organizationId, id])
  sire          Animal?             @relation("ProductSire", fields: [organizationId, sireId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  batches       ProductBatch[]
  movements     StockMovement[]
  applications  HealthApplication[]
  planItems     HealthPlanItem[]
  feedingEvents FeedingEvent[]

  @@unique([farmId, id])
  @@index([farmId, kind])
  @@map("products")
}

/// Lote/partida do fabricante (ou partida de sêmen) com validade.
model ProductBatch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  code           String
  expiresOn      DateTime? @map("expires_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  farm         Farm                @relation(fields: [organizationId, farmId], references: [organizationId, id])
  product      Product             @relation(fields: [farmId, productId], references: [farmId, id])
  movements    StockMovement[]
  applications HealthApplication[]

  @@unique([farmId, id])
  @@unique([productId, code])
  @@map("product_batches")
}

model StockLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  farm      Farm            @relation(fields: [organizationId, farmId], references: [organizationId, id])
  movements StockMovement[]

  @@unique([farmId, id])
  @@map("stock_locations")
}

/// Movimento de estoque com quantidade assinalada (+ entrada, − consumo/perda).
/// Saldo = soma dos movimentos não anulados. Consumo de campo nunca é bloqueado:
/// quando deixa o saldo negativo, fica marcado para reconciliação administrativa.
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  farmId         String            @map("farm_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  batchId        String?           @map("batch_id") @db.Uuid
  locationId     String?           @map("location_id") @db.Uuid
  kind           StockMovementKind
  quantity       Decimal           @db.Decimal(14, 3)
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(14, 4)
  occurredOn     DateTime          @map("occurred_on") @db.Date
  sourceType     String?           @map("source_type")
  sourceId       String?           @map("source_id") @db.Uuid
  note           String?
  needsReview    Boolean           @default(false) @map("needs_review")
  reviewedAt     DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedById   String?           @map("reviewed_by_id") @db.Uuid
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidReason     String?           @map("void_reason")

  farm     Farm           @relation(fields: [organizationId, farmId], references: [organizationId, id])
  product  Product        @relation(fields: [farmId, productId], references: [farmId, id])
  batch    ProductBatch?  @relation(fields: [farmId, batchId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  location StockLocation? @relation(fields: [farmId, locationId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([farmId, productId])
  @@index([farmId, needsReview])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

/// Item do calendário sanitário configurado pela fazenda (não há plano padrão).
model HealthPlanItem {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  farmId         String           @map("farm_id") @db.Uuid
  name           String
  kind           HealthKind
  productId      String?          @map("product_id") @db.Uuid
  categories     AnimalCategory[]
  everyDays      Int?             @map("every_days")
  firstAtAgeDays Int?             @map("first_at_age_days")
  /// Responsável técnico / origem do plano.
  source         String
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)

  farm         Farm                @relation(fields: [organizationId, farmId], references: [organizationId, id])
  product      Product?            @relation(fields: [farmId, productId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  applications HealthApplication[]

  @@unique([farmId, id])
  @@map("health_plan_items")
}

model HealthApplication {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  farmId              String      @map("farm_id") @db.Uuid
  animalId            String      @map("animal_id") @db.Uuid
  operationId         String      @map("operation_id") @db.Uuid
  kind                HealthKind
  productId           String?     @map("product_id") @db.Uuid
  /// Nome do produto no momento da aplicação (histórico não muda se o cadastro mudar).
  productName         String      @map("product_name")
  batchId             String?     @map("batch_id") @db.Uuid
  dose                Decimal?    @db.Decimal(12, 3)
  unit                String?
  route               AdminRoute?
  appliedOn           DateTime    @map("applied_on") @db.Date
  applicator          String?
  reason              String?
  planItemId          String?     @map("plan_item_id") @db.Uuid
  sessionId           String?     @map("session_id") @db.Uuid
  treatmentId         String?     @map("treatment_id") @db.Uuid
  withdrawalMeatUntil DateTime?   @map("withdrawal_meat_until") @db.Date
  withdrawalMilkUntil DateTime?   @map("withdrawal_milk_until") @db.Date
  stockMovementId     String?     @map("stock_movement_id") @db.Uuid
  createdById         String?     @map("created_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt            DateTime?   @map("voided_at") @db.Timestamptz(3)
  voidReason          String?     @map("void_reason")

  farm      Farm             @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animal    Animal           @relation(fields: [organizationId, animalId], references: [organizationId, id])
  product   Product?         @relation(fields: [farmId, productId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  batch     ProductBatch?    @relation(fields: [farmId, batchId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  planItem  HealthPlanItem?  @relation(fields: [farmId, planItemId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  session   HandlingSession? @relation(fields: [farmId, sessionId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  treatment Treatment?       @relation(fields: [farmId, treatmentId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([animalId, appliedOn])
  @@index([farmId, appliedOn])
  @@index([farmId, operationId])
  @@map("health_applications")
}

model Treatment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  farmId         String          @map("farm_id") @db.Uuid
  animalId       String          @map("animal_id") @db.Uuid
  startedOn      DateTime        @map("started_on") @db.Date
  condition      String
  /// Plano informado pelo responsável técnico (texto livre; o Rebania não prescreve).
  plan           String?
  responsible    String?
  status         TreatmentStatus @default(open)
  outcome        String?
  endedOn        DateTime?       @map("ended_on") @db.Date
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  farm         Farm                @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animal       Animal              @relation(fields: [organizationId, animalId], references: [organizationId, id])
  applications HealthApplication[]

  @@unique([farmId, id])
  @@index([farmId, status])
  @@map("treatments")
}

model Exam {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  farmId         String     @map("farm_id") @db.Uuid
  animalId       String     @map("animal_id") @db.Uuid
  operationId    String     @map("operation_id") @db.Uuid
  kind           String
  collectedOn    DateTime   @map("collected_on") @db.Date
  responsible    String?
  status         ExamStatus @default(pending)
  result         String?
  resultOn       DateTime?  @map("result_on") @db.Date
  notes          String?
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?  @map("voided_at") @db.Timestamptz(3)
  voidReason     String?    @map("void_reason")

  farm   Farm   @relation(fields: [organizationId, farmId], references: [organizationId, id])
  animal Animal @relation(fields: [organizationId, animalId], references: [organizationId, id])

  @@index([farmId, status])
  @@index([animalId, collectedOn])
  @@map("exams")
}

/// Sessão de manejo (Modo Curral): configuração única + snapshot dos animais.
model HandlingSession {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  farmId         String                @map("farm_id") @db.Uuid
  name           String
  date           DateTime              @db.Date
  status         HandlingSessionStatus @default(open)
  /// Configuração validada por @rebania/contracts HandlingConfig.
  config         Json
  summary        Json?
  createdById    String?               @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz(3)
  closedById     String?               @map("closed_by_id") @db.Uuid
  version        Int                   @default(1)

  farm         Farm                       @relation(fields: [organizationId, farmId], references: [organizationId, id])
  items        HandlingSessionItem[]
  exceptions   HandlingSessionException[]
  applications HealthApplication[]

  @@unique([farmId, id])
  @@index([farmId, status])
  @@map("handling_sessions")
}

model HandlingSessionItem {
  sessionId String             @map("session_id") @db.Uuid
  animalId  String             @map("animal_id") @db.Uuid
  farmId    String             @map("farm_id") @db.Uuid
  position  Int
  status    HandlingItemStatus @default(pending)
  /// Animal lido durante a sessão, fora da seleção inicial.
  added     Boolean            @default(false)
  weightId  String?            @map("weight_id") @db.Uuid
  note      String?
  doneAt    DateTime?          @map("done_at") @db.Timestamptz(3)
  doneById  String?            @map("done_by_id") @db.Uuid

  session HandlingSession @relation(fields: [farmId, sessionId], references: [farmId, id])
  animal  Animal          @relation(fields: [farmId, animalId], references: [farmId, id])

  @@id([sessionId, animalId])
  @@map("handling_session_items")
}

/// Exceções registradas durante a sessão (ID desconhecido, leitor, observação).
model HandlingSessionException {
  id               String    @id @default(uuid()) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  farmId           String    @map("farm_id") @db.Uuid
  kind             String
  value            String?
  note             String?
  resolvedAnimalId String?   @map("resolved_animal_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session HandlingSession @relation(fields: [farmId, sessionId], references: [farmId, id])

  @@index([sessionId])
  @@map("handling_session_exceptions")
}

// ---- G5: comercialização, saídas, trato e financeiro ---------------------------------

enum CommercialKind {
  sale
  purchase
}

enum PriceMode {
  per_head
  per_kg_live
  per_arroba
  total
}

enum EntryKind {
  income
  expense
}

enum EntryStatus {
  open
  paid
  cancelled
}

/// Compra ou venda de animais. Valores em centavos; arroba só como estimativa com rendimento informado.
model CommercialTransaction {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  farmId              String         @map("farm_id") @db.Uuid
  kind                CommercialKind
  date                DateTime       @db.Date
  counterparty        String
  document            String?
  priceMode           PriceMode      @map("price_mode")
  unitCents           BigInt         @map("unit_cents")
  totalCents          BigInt         @map("total_cents")
  heads               Int
  totalLiveKg         Decimal?       @map("total_live_kg") @db.Decimal(12, 2)
  carcassYieldPercent Decimal?       @map("carcass_yield_percent") @db.Decimal(5, 2)
  estimatedArrobas    Decimal?       @map("estimated_arrobas") @db.Decimal(12, 2)
  formula             String
  notes               String?
  /// Exceção de carência: quem liberou e por quê (somente pessoas com permissão).
  withdrawalOverride  Json?          @map("withdrawal_override")
  financialEntryId    String?        @map("financial_entry_id") @db.Uuid
  createdById         String?        @map("created_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt            DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidReason          String?        @map("void_reason")

  farm  Farm             @relation(fields: [organizationId, farmId], references: [organizationId, id])
  items CommercialItem[]

  @@unique([farmId, id])
  @@index([farmId, kind, date])
  @@map("commercial_transactions")
}

model CommercialItem {
  transactionId  String   @map("transaction_id") @db.Uuid
  animalId       String   @map("animal_id") @db.Uuid
  farmId         String   @map("farm_id") @db.Uuid
  liveWeightKg   Decimal? @map("live_weight_kg") @db.Decimal(8, 2)
  allocatedCents BigInt   @map("allocated_cents")

  transaction CommercialTransaction @relation(fields: [farmId, transactionId], references: [farmId, id])
  animal      Animal                @relation(fields: [farmId, animalId], references: [farmId, id])

  @@id([transactionId, animalId])
  @@index([animalId])
  @@map("commercial_items")
}

/// Lançamento financeiro (receita/despesa) com vencimento, pagamento e rateio.
model FinancialEntry {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  farmId         String      @map("farm_id") @db.Uuid
  kind           EntryKind
  category       String
  description    String
  amountCents    BigInt      @map("amount_cents")
  dueOn          DateTime    @map("due_on") @db.Date
  paidOn         DateTime?   @map("paid_on") @db.Date
  status         EntryStatus @default(open)
  counterparty   String?
  document       String?
  /// Rateio: farm (fazenda toda), group (lotes) ou animals.
  allocationType String      @default("farm") @map("allocation_type")
  allocationIds  String[]    @default([]) @map("allocation_ids") @db.Uuid
  sourceType     String?     @map("source_type")
  sourceId       String?     @map("source_id") @db.Uuid
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelReason   String?     @map("cancel_reason")
  version        Int         @default(1)

  farm Farm @relation(fields: [organizationId, farmId], references: [organizationId, id])

  @@index([farmId, status, dueOn])
  @@index([farmId, paidOn])
  @@map("financial_entries")
}

/// Trato/fornecimento por lote: dieta, quantidade, consumo de estoque e custo estimado.
model FeedingEvent {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  farmId          String    @map("farm_id") @db.Uuid
  groupId         String?   @map("group_id") @db.Uuid
  date            DateTime  @db.Date
  diet            String
  productId       String?   @map("product_id") @db.Uuid
  quantity        Decimal   @db.Decimal(14, 3)
  unit            String
  heads           Int
  /// Custo médio de entrada do produto × quantidade (null sem custo informado nas entradas).
  costCents       BigInt?   @map("cost_cents")
  stockMovementId String?   @map("stock_movement_id") @db.Uuid
  notes           String?
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason      String?   @map("void_reason")

  farm    Farm     @relation(fields: [organizationId, farmId], references: [organizationId, id])
  group   Group?   @relation(fields: [farmId, groupId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)
  product Product? @relation(fields: [farmId, productId], references: [farmId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([farmId, date])
  @@map("feeding_events")
}

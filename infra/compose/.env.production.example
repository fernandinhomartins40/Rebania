# Copie para /opt/rebania/infra/compose/.env (fora do git) na VPS 72.60.10.112 e rode `chmod 600`.
# REBANIA_TAG e REBANIA_REGISTRY são reescritos a cada deploy pelo workflow (infra/scripts/deploy.sh).
REBANIA_TAG=
REBANIA_REGISTRY=ghcr.io/fernandinhomartins40/
PUBLIC_URL=https://www.rebania.com.br
POSTGRES_PASSWORD=troque-por-um-segredo-forte
# Porta loopback para o Nginx do host encaminhar (não usar 80/443)
REBANIA_HTTP_PORT=8088
# IA: DeepSeek. Para ligar: AI_PROVIDER=deepseek e a chave abaixo (painel da DeepSeek). "none" = indisponível.
AI_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Pagamento ainda não decidido (P-02). "none" deixa a compra online indisponível, sem simular.
BILLING_PROVIDER=none
# Só se BILLING_PROVIDER=hmac (conciliação assinada): segredo com 32+ caracteres
BILLING_WEBHOOK_SECRET=
# Token do coletor de métricas (24+ caracteres). Vazio = /v1/metrics desligado.
METRICS_TOKEN=

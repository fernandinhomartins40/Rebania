{
  "name": "@rebania/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "bootstrap": "tsx --env-file-if-exists=../../.env src/cli/bootstrap.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "platform-admin": "tsx --env-file-if-exists=../../.env src/cli/platform-admin.ts",
    "seed-demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rebania/ai-gateway": "workspace:*",
    "@rebania/contracts": "workspace:*",
    "@rebania/db": "workspace:*",
    "@rebania/domain": "workspace:*",
    "@rebania/media": "workspace:*",
    "@rebania/sync-core": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@rebania/config": "workspace:*",
    "@types/pg": "8.20.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}

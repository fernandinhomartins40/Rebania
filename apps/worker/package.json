{
  "name": "@rebania/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --sourcemap --clean --no-external @rebania/db --no-external @rebania/domain",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@rebania/db": "workspace:*",
    "@rebania/domain": "workspace:*"
  },
  "devDependencies": {
    "@rebania/config": "workspace:*"
  }
}

{
  "expo": {
    "name": "Rebania",
    "slug": "rebania",
    "scheme": "rebania",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4ED",
    "primaryColor": "#163E32",
    "ios": {
      "bundleIdentifier": "com.rebania.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.rebania.app",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F4ED"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Rebania usa a câmera para ler o QR/código do brinco e fotografar os animais.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Rebania acessa suas fotos para anexar imagens ao histórico do animal.",
          "cameraPermission": "O Rebania usa a câmera para fotografar os animais."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/brand/rebania-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4ED"
    }
  }
}
